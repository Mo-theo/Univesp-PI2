# Copie este arquivo para .env e ajuste os valores.
# Gere uma chave com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-esta-chave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Deixe vazio para usar SQLite local (db.sqlite3).
# Produção (PostgreSQL): postgres://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=
# Senha do porteiro de DEMONSTRAÇÃO (comando criar_porteiro_demo).
# Se vazio, a senha é pedida no terminal. Nunca commite o .env.
PORTEIRO_DEMO_PASSWORD=

# --- Produção / simulação de produção ---
# Origens extras confiáveis para CSRF (separadas por vírgula), ex.: https://meu-dominio.com.br
# No Render, https://<RENDER_EXTERNAL_HOSTNAME> é adicionado automaticamente.
CSRF_TRUSTED_ORIGINS=
# Com DEBUG=False o HTTPS é exigido. Para simular produção localmente em HTTP, use False.
# FORCAR_HTTPS=False
# Exigir SSL na conexão com o banco (use True com a URL EXTERNA do Render).
# DATABASE_SSL_REQUIRE=False
